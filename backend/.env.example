# Copy this file to ".env" and fill it in. NEVER commit the real .env file.

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Required in production. Use a high-entropy random value and keep it server-side.
ANONYMOUS_SESSION_SECRET=

# NODE_ENV selects which pair is used:
# development -> local PostgreSQL
# production -> hosted PostgreSQL such as Neon
DATABASE_URL_DEVELOPMENT=postgresql://postgres:password@localhost:5432/field_shift_dev
DIRECT_URL_DEVELOPMENT=postgresql://postgres:password@localhost:5432/field_shift_dev

# In the Neon dashboard, DATABASE_URL_PRODUCTION is the pooled string
# and DIRECT_URL_PRODUCTION is the direct string.
DATABASE_URL_PRODUCTION=postgresql://user:password@host-pooler.example/db?sslmode=require
DIRECT_URL_PRODUCTION=postgresql://user:password@host.example/db?sslmode=require

# Optional: serve the built frontend from this server (demo mode).
# FRONTEND_DIST=../frontend/dist
