# Copy to backend/.env and fill in. NEVER commit .env (it is git-ignored).
# Ports used together:  API 4000  <-  Vite dev proxy  <-  browser on http://localhost:5173

# --- API ---
PORT=4000
NODE_ENV=development
# Browser origins allowed to call the API, comma-separated, no trailing slash. Include the Vite dev server (port 5173, see frontend/vite.config.js).
CORS_ORIGIN=http://localhost:5173,https://your-app.example.com
# Required in production (32+ characters). Optional in development (a random one is used per run).
ANONYMOUS_SESSION_SECRET=
TRUST_PROXY=0

# --- Database (NODE_ENV selects the pair) ---
DATABASE_URL_DEVELOPMENT=postgresql://fieldshift:choose-a-password@localhost:5432/fieldshift
DIRECT_URL_DEVELOPMENT=postgresql://fieldshift:choose-a-password@localhost:5432/fieldshift
DATABASE_URL_PRODUCTION=
DIRECT_URL_PRODUCTION=

# --- Offline demo (see docs/OFFLINE.md) ---
# 1 = serve climate from backend/data/offline/*.json only; never touch the database or the network.
# 0 / unset = use the database, and fall back to those files if it is not configured or cannot be reached.
OFFLINE=0
# OFFLINE_DATA_DIR=            # default: backend/data/offline
# Optional: folder with the built frontend, served by the API itself (single-server demo): FRONTEND_DIST=../frontend/dist
FRONTEND_DIST=

# --- NASA ---
# Earthdata token for GPM IMERG (ingestion scripts only). Tokens EXPIRE: generate a fresh one before the event at
# https://urs.earthdata.nasa.gov (Generate Token). Never commit it.
EARTHDATA_TOKEN=
NASA_POWER_TIMEOUT_MS=120000
NASA_POWER_RETRIES=3
IMERG_CONCURRENCY=4
IMERG_TIMEOUT_MS=60000
