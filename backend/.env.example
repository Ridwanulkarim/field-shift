# Copy this file to ".env" and fill it in. NEVER commit the real .env file.

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Neon PostgreSQL (see docs/SETUP.md) ---
# In the Neon dashboard click "Connect", then copy BOTH strings.
# DATABASE_URL = the POOLED string (host contains "-pooler"). Used by the running API.
# DIRECT_URL   = the DIRECT string (no "-pooler"). Used by "prisma migrate".
# Remove "&channel_binding=require" if it is present at the end of the string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Optional: serve the built frontend from this server (demo mode).
# FRONTEND_DIST=../frontend/dist
