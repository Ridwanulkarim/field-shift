{
  "name": "field-shift-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Field Shift API: climate-aware crop rotation exploration for Bangladesh using NASA data",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "start:offline": "node --env-file-if-exists=.env scripts/start-offline.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "node --env-file-if-exists=.env scripts/seed-reference.js",
    "db:seed:synthetic": "node --env-file-if-exists=.env scripts/seed-synthetic.js",
    "ingest:nasa": "node --env-file-if-exists=.env scripts/ingest-nasa.js",
    "ingest:nasa:cell": "node --env-file-if-exists=.env scripts/ingest-nasa-grid-cell.js",
    "ingest:field-cells": "node --env-file-if-exists=.env scripts/ingest-field-cells.js",
    "probe:imerg": "node --env-file-if-exists=.env scripts/probe-imerg.js",
    "ingest:imerg:cells": "node --env-file-if-exists=.env scripts/ingest-imerg-cells.js",
    "check:crops": "node scripts/check-crop-sheet.js",
    "build:crop-sources": "node scripts/build-crop-sources.js",
    "ingest:refresh": "node --env-file-if-exists=.env scripts/refresh-nasa.js",
    "db:backfill-cells": "node --env-file-if-exists=.env scripts/backfill-grid-cells.js",
    "check:grid-consistency": "node --env-file-if-exists=.env scripts/check-grid-consistency.js",
    "check:power-grid": "node --env-file-if-exists=.env scripts/check-power-grid.js",
    "verify:live": "node --env-file-if-exists=.env scripts/verify-live-data.js",
    "screen:advisory": "node --env-file-if-exists=.env scripts/screen-advisory.js",
    "screen:indicators": "node --env-file-if-exists=.env scripts/screen-indicators.js",
    "export:bangla": "node scripts/export-bangla-review.js",
    "ingest:nasa:cell:refresh": "node --env-file-if-exists=.env scripts/refresh-nasa-grid-cell.js",
    "export:offline": "node --env-file-if-exists=.env scripts/export-offline.js",
    "check:offline": "node --env-file-if-exists=.env scripts/check-offline.js",
    "check:rotation": "node --env-file-if-exists=.env scripts/check-rotation-ranking.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
