{
  "name": "field-shift-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Field Shift API: climate-aware crop rotation exploration for Bangladesh using NASA data",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "node --env-file-if-exists=.env scripts/seed-reference.js",
    "db:seed:synthetic": "node --env-file-if-exists=.env scripts/seed-synthetic.js",
    "ingest:nasa": "node --env-file-if-exists=.env scripts/ingest-nasa.js",
    "analyze:onset": "node --env-file-if-exists=.env scripts/analyze-onset.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
