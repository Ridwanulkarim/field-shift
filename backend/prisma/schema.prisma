// Field Shift database schema (PostgreSQL, hosted on Neon).
// The generated client goes to src/generated/prisma (git-ignored; created by `npm run db:generate`).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  SUCCESS
  FAILED
}

// A study area. Pilot districts only; coordinates are APPROXIMATE (see coordNote).
model District {
  id        Int    @id @default(autoincrement())
  slug      String @unique
  nameEn    String
  nameBn    String
  division  String
  latitude  Float
  longitude Float
  coordNote String

  datasetRuns  DatasetRun[]
  climateDaily ClimateDaily[]
  fields       Field[]
}

// Registered agricultural fields with PostGIS boundaries.
model Field {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String?  @unique @db.VarChar(64)
  name       String
  districtId Int
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  // Stored and spatially analyzed by PostGIS.
  // Prisma cannot directly read or write this unsupported geometry field.
  boundary Unsupported("geometry(MultiPolygon,4326)")?

  // Calculated by the backend using PostGIS.
  areaHa Float?

  // Optional farmer-provided field information.
  soilType         String?
  soilPh           Float?
  organicMatterPct Float?
  salinityDsM      Float?
  irrigationSource String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([districtId])
  // Spatial index created by the add_field_boundaries migration (PostGIS GiST).
  @@index([boundary], type: Gist)
}

// Crop traits used by the rotation engine.
// `basis` says how trustworthy the numbers are. Until a person has checked them
// against BRRI / BARI / FAO sources it must stay UNVERIFIED_GENERAL_KNOWLEDGE.
model Crop {
  id                    Int     @id @default(autoincrement())
  slug                  String  @unique
  nameEn                String
  nameBn                String
  family                String // botanical family, used for rotation diversity
  isLegume              Boolean
  startMonth            Int // typical first month in the field (1-12)
  endMonth              Int // typical last month in the field (wraps past December)
  waterNeedMmMin        Int // approximate seasonal water need, mm (heuristic)
  waterNeedMmMax        Int
  heatThresholdC        Float // daily max temperature treated as heat stress (heuristic)
  heatSensitivity       Int // 1 (tolerant) to 5 (sensitive)
  salinityTolerance     Int // 1 (sensitive) to 5 (tolerant)
  waterloggingTolerance Int // 1 (sensitive) to 5 (tolerant)
  inputIntensity        Int // 1 (low input) to 5 (high input)
  basis                 String // UNVERIFIED_GENERAL_KNOWLEDGE, PARTIALLY_VERIFIED or VERIFIED
  traitSources          Json? // per-trait { basis, citation }; null on rows seeded before Phase 4
  notes                 String
}

// One provider dataset ingestion attempt. A district run belongs to a district and is deleted with it.
// A standalone grid-cell run has districtId = null and is identified by gridCellId; district deletion never touches it.
model DatasetRun {
  id            Int            @id @default(autoincrement())
  districtId    Int?
  district      District?      @relation(fields: [districtId], references: [id], onDelete: Cascade)
  source        String // e.g. "NASA POWER" or "SYNTHETIC"
  product       String?
  isSynthetic   Boolean        @default(false)
  status        RunStatus
  endpointUrl   String
  requestParams Json
  retrievedAt   DateTime       @default(now())
  startDate     DateTime       @db.Date
  endDate       DateTime       @db.Date
  fillValue     Float?
  units         Json?
  rowCount      Int            @default(0)
  missingCount  Int            @default(0)
  errorMessage  String?
  notes         String?
  // The provider grid cell this run describes (null for synthetic runs and for runs stored before
  // cells were recorded; `npm run db:backfill-cells` fills those in).
  gridCellId    Int?
  gridCell      ClimateGridCell? @relation(fields: [gridCellId], references: [id], onDelete: SetNull)
  climateDaily  ClimateDaily[]

  @@index([districtId, source, isSynthetic, status, retrievedAt])
  @@index([gridCellId, status, isSynthetic, retrievedAt])
}

// One cell of a data provider's grid. Climate values describe the whole cell, never a single point,
// so fields and districts that fall in the same cell share the same observations.
model ClimateGridCell {
  id        Int      @id @default(autoincrement())
  provider  String // e.g. "NASA POWER"; a future GPM IMERG cell has its own provider and grid
  cellKey   String // "<latIndex>:<lonIndex>" on that provider's grid
  gridName  String
  centerLat Float
  centerLon Float
  resLatDeg Float
  resLonDeg Float
  createdAt DateTime @default(now())

  runs DatasetRun[]

  @@unique([provider, cellKey])
}

// Daily values. null means "missing", never a guessed number. District linkage is optional for cell-first ingestion.
model ClimateDaily {
  id           Int        @id @default(autoincrement())
  runId        Int
  run          DatasetRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  districtId   Int?
  district     District?  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  date         DateTime   @db.Date
  precipMm     Float?
  tMaxC        Float?
  tMinC        Float?
  // RESERVED, currently unused: nothing writes this column. It will be dropped or reshaped when
  // the next dataset (GPM IMERG) is added and its real structure is known.
  measurements Json?

  @@unique([runId, date])
  @@index([districtId, date])
}

// Coordinates ingestion jobs so overlapping workers cannot replace one another.
// Used through raw SQL in src/data/climateStore.js (withIngestionLock); modelled here so that
// `prisma migrate dev` does not try to drop the table.
model DatasetIngestionLock {
  key        String   @id
  owner      String   @db.Uuid
  acquiredAt DateTime @default(now())
}
