# Field Shift - Frontend Environment Variables
# Vite requires environment variables to be prefixed with VITE_

# 1. Local Development (default when backend is running on port 5001)
VITE_API_BASE=http://localhost:5001/api

# 2. Production Deployment (e.g. Vercel / Cloud)
# If frontend and backend are hosted on the same domain, use relative path:
# VITE_API_BASE=/api
# Or if backend is hosted on a separate service:
# VITE_API_BASE=https://your-backend-app.onrender.com/api
